{
  "name": "hardless",
  "version": "0.1.1",
  "description": "Emulated POS hardware for web app development and testing: receipt printers, cash drawers, barcode scanners and NFC readers. Run it with npx hardless start.",
  "keywords": [
    "pos",
    "point-of-sale",
    "emulator",
    "receipt-printer",
    "escpos",
    "testing",
    "cash-drawer",
    "barcode-scanner",
    "nfc",
    "web-serial",
    "webusb",
    "web-nfc",
    "mcp",
    "cli"
  ],
  "homepage": "https://hardless-docs.netlify.app",
  "bugs": {
    "url": "https://github.com/hardlessdev/hardless/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardlessdev/hardless.git",
    "directory": "packages/npm-wrapper"
  },
  "type": "module",
  "bin": {
    "hardless": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}

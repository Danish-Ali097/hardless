{
  "name": "@hardless/shim-web",
  "version": "0.0.0",
  "description": "Browser API shims (Web Serial, WebUSB, Web NFC, keyboard wedge) backed by Hardless emulated devices.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardlessdev/hardless.git",
    "directory": "packages/shim-web"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./iife": "./dist/hardless-shim.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./iife": "./dist/hardless-shim.iife.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && vite build -c vite.iife.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@hardless/types": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.4"
  }
}

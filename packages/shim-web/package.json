{
  "name": "@hardless/shim-web",
  "version": "0.1.1",
  "description": "Drop-in navigator.serial, navigator.usb and NDEFReader backed by emulated POS devices (receipt printer, cash drawer, NFC reader, barcode scanner), for developing and testing web apps without hardware.",
  "keywords": [
    "pos",
    "point-of-sale",
    "emulator",
    "receipt-printer",
    "escpos",
    "testing",
    "web-serial",
    "webusb",
    "web-nfc",
    "ndef",
    "shim",
    "polyfill",
    "barcode-scanner",
    "cash-drawer"
  ],
  "homepage": "https://hardless-docs.netlify.app/quickstart",
  "bugs": {
    "url": "https://github.com/hardlessdev/hardless/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardlessdev/hardless.git",
    "directory": "packages/shim-web"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./iife": "./dist/hardless-shim.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./iife": "./dist/hardless-shim.iife.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && vite build -c vite.iife.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@hardless/types": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.4"
  }
}

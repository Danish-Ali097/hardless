{
  "name": "@hardless/playwright",
  "version": "0.1.1",
  "description": "Playwright fixture and matchers (toHavePrinted, toHaveOpened, ...) for testing POS web apps against emulated receipt printers, cash drawers, scanners and NFC readers.",
  "keywords": [
    "pos",
    "point-of-sale",
    "emulator",
    "receipt-printer",
    "escpos",
    "testing",
    "playwright",
    "e2e",
    "fixture",
    "matchers",
    "web-serial",
    "webusb",
    "web-nfc"
  ],
  "homepage": "https://hardless-docs.netlify.app/testing",
  "bugs": {
    "url": "https://github.com/hardlessdev/hardless/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardlessdev/hardless.git",
    "directory": "packages/playwright"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hardless/shim-web": "workspace:*",
    "@hardless/types": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "^1.50.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}

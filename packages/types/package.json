{
  "name": "@hardless/types",
  "version": "0.1.1",
  "description": "TypeScript types for the Hardless POS hardware emulator's REST API, events and wire messages.",
  "keywords": [
    "pos",
    "point-of-sale",
    "emulator",
    "receipt-printer",
    "escpos",
    "testing",
    "types",
    "typescript"
  ],
  "homepage": "https://hardless-docs.netlify.app/rest-api",
  "bugs": {
    "url": "https://github.com/hardlessdev/hardless/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardlessdev/hardless.git",
    "directory": "packages/types"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
